<!-- Triple Cartpole Model, Credit: https://github.com/vincekurtz/hydrax -->
<mujoco model="triplecartpole">
  <option integrator="implicitfast" timestep="0.01" iterations="1" ls_iterations="5">
    <flag contact="disable"/>
  </option>

  <statistic center="0 0 3" extent="8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global elevation="0"/>
  </visual>

  <default>
    <default class="pole">
      <joint type="hinge" axis="0 1 0" damping="1e-2"/>
      <geom type="capsule" fromto="0 0 -1 0 0 0" size="0.045" mass=".1"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 6" dir="0 0 -1" directional="false"/>
    <geom name="floor" pos="0 0 -0.05" size="0 0 .125" type="plane" material="groundplane" conaffinity="15" condim="3"/>
    <camera name="fixed" pos="0 -10 3" zaxis="0 -1 0"/>
    <camera name="lookatcart" mode="targetbody" target="cart" pos="0 -2 3"/>
    <geom name="rail1" type="capsule" pos="0  .07 3" zaxis="1 0 0" size="0.02 4"/>
    <geom name="rail2" type="capsule" pos="0 -.07 3" zaxis="1 0 0" size="0.02 4"/>
    <body name="cart" pos="0 0 3">
      <joint name="slider" type="slide" limited="false" axis="1 0 0" damping="1.0e-4"/>
      <geom name="cart" type="box" size="0.2 0.15 0.1" mass="1"/>
      <body name="pole_1" childclass="pole">
        <joint name="hinge_1"/>
        <geom name="pole_1"/>
        <body name="pole_2" childclass="pole" pos="0 0 -1">
          <joint name="hinge_2"/>
          <geom name="pole_2"/>
          <body name="pole_3" childclass="pole" pos="0 0 -1">
            <joint name="hinge_3"/>
            <geom name="pole_3"/>
            <site name="tip" pos="0 0 -1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="slide" joint="slider" ctrllimited="false" />
  </actuator>
</mujoco>
